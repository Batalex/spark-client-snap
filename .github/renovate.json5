{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>canonical/data-platform//renovate_presets/charm.json5",
  ],
  "reviewers": [
    "welpaolo",
    "theoctober19th",
    "batalex",
  ],
  "schedule": ["* 3 * * 5"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3 * * 5"]
  },
  "ignoreDeps": ["ubuntu"],
  "baseBranchPatterns": [
    '/^*\\/edge$/',
  ],
  "customManagers": [
    {
      // Matches shell version variables annotated with:
      //   # renovate: datasource=<ds> depName=<name> extractVersion=<pattern>
      // Used for GitHub Releases JARs (e.g. canonical/central-uploader) in snapcraft.yaml
      "customType": "regex",
      "fileMatch": ["(^|/)snap/snapcraft\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+extractVersion=(?<extractVersion>[^\\n]+)\\n\\s+\\w+_VERSION='(?<currentValue>[^']+)'"
      ]
    },
    {
      // Matches pip install lines annotated with:
      //   # renovate: datasource=pypi
      // Used for Python packages in snapcraft.yaml overlay-scripts
      "customType": "regex",
      "fileMatch": ["(^|/)snap/snapcraft\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=pypi\\n\\s+-\\s+(?<depName>[^=\\s]+)==(?<currentValue>[^\\s\\n]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update Spark tarball version in snapcraft.yaml",
      "fileMatch": ["(^|/)snap/snapcraft\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)\\s+depType=(?<depType>[^\\s\\n]+)\\n\\s+source:\\s*https://github\\.com/[^\\s]+/releases/download/(?<currentValue>spark-\\d+\\.\\d+\\.\\d+-ubuntu\\d+)/[^\\s]+\\.tgz"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^spark-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ubuntu(?<build>\\d+)$"
    }

  ],
  "postUpgradeTasks": {
    "commands": [
      "export ASSET_URL=$(curl -s https://api.github.com/repos/canonical/central-uploader/releases/tags/{{{newValue}}} | grep browser_download_url | grep -o 'https://[^\"]*bin-k8s\\.tgz')",
      "export ASSET_SHA512=$(wget -qO- \"$ASSET_URL\" | sha512sum | awk '{print $1}')",
      "sed -i -e \"s|https://github.com/canonical/central-uploader/releases/download/[^ ]*\\.tgz|$ASSET_URL|g\" {{{fileFilters}}}",
      "sed -i -E -e \"s|^([[:space:]]*source-checksum:[[:space:]]*)sha512/[a-f0-9]+$|\\1sha512/$ASSET_SHA512|\" {{{fileFilters}}}"
    ],
    "fileFilters": [
      "**/snapcraft.yaml"
    ],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchPackageNames": ["spark8t"],
      "allowedVersions": "< 2.0.0"
    },
    {
      // Only allow minor and patch updates for central-uploader deps
      // depType is captured from the shell variable name in customManagers
      // "canonical/central-uploader" 
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["canonical/central-uploader"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Only allow minor and patch updates for central-uploader deps
      // depType is captured from the shell variable name in customManagers
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["canonical/central-uploader"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      // Only allow patch updates for spark tarball source
      "matchDepTypes": ["spark-source"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}

